#!/usr/bin/env bash
set -euo pipefail

dry_run=0
algo=""
graph_path="../data/soc-LiveJournal1.mtx"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)
      dry_run=1
      shift
      ;;
    -h|--help)
      echo "Usage: $0 <algo> [graph_path] [--dry-run]" >&2
      exit 0
      ;;
    *)
      if [[ -z "$algo" ]]; then
        algo="$1"
      elif [[ "$graph_path" == "../data/soc-LiveJournal1.mtx" ]]; then
        graph_path="$1"
      else
        echo "Unexpected arg: $1" >&2
        exit 1
      fi
      shift
      ;;
  esac
done

if [[ -z "$algo" ]]; then
  echo "Usage: $0 <algo> [graph_path] [--dry-run]" >&2
  exit 1
  fi

if [[ ! -x "./run_graph_algorithms" ]]; then
  echo "Error: ./run_graph_algorithms not found or not executable in $(pwd)" >&2
  exit 1
  fi

graph_name=$(basename "$graph_path" | sed 's/\.[^.]*$//')

sym_arg=""
if [[ "$graph_name" == *"kron"* || "$graph_name" == *"italy"* ]]; then
  sym_arg="--symmetric"
fi

for run_idx in 1 2 3; do
  echo "Starting run $run_idx/3..."
  output_file="bench_${algo}_${graph_name}_run${run_idx}.data"
benchmark_core="2"
perf_core="0"
measurement_file="./measurement"
ack_file="./measurement.attached"

  rm -f "$measurement_file" "$ack_file"

  taskset -c "$benchmark_core" env GRUDON_PROFILE=1 ./run_graph_algorithms "$graph_path" "$algo" $sym_arg &
  bench_pid=$!

cleanup() {
  rm -f "$ack_file"
}
trap cleanup EXIT

  start_ms=$(date +%s%3N)
  while true; do
  if [[ -f "$measurement_file" ]]; then
    mapfile -t lines < "$measurement_file"
    flag="${lines[0]:-}"
    pid_line="${lines[1]:-}"
    if [[ "$flag" == "1" && -n "$pid_line" ]]; then
      if [[ "$dry_run" -eq 1 ]]; then
        echo "[dry-run] Would run: taskset -c $perf_core sudo perf record -o $output_file -g -p $pid_line -e 'cycles,instructions'" >&2
        echo "[dry-run] Would write perf data to: $output_file" >&2
        touch "$ack_file"
        wait "$bench_pid" 2>/dev/null || true
      else
        taskset -c "$perf_core" sudo perf record -o "$output_file" -g -p "$pid_line" -e 'cycles,instructions' &
        perf_pid=$!

        touch "$ack_file"

        while true; do
          if [[ -f "$measurement_file" ]]; then
            mapfile -t lines < "$measurement_file"
            flag="${lines[0]:-}"
            if [[ "$flag" == "0" ]]; then
              kill -INT "$perf_pid" 2>/dev/null || true
              break
            fi
          fi
          sleep 0.001
        done

        wait "$perf_pid" 2>/dev/null || true
        wait "$bench_pid" 2>/dev/null || true
      fi
      break
    fi
  fi
  now_ms=$(date +%s%3N)
  if (( now_ms - start_ms > 90000 )); then
    echo "Error: measurement flag not observed within 30s" >&2
    kill "$bench_pid" 2>/dev/null || true
    wait "$bench_pid" 2>/dev/null || true
    exit 1
  fi
  sleep 0.001
done

  # Clear file caches to avoid cross-run interference
  if [[ "$dry_run" -eq 1 ]]; then
  echo "[dry-run] Would run: sudo sync && echo 1 | sudo tee /proc/sys/vm/drop_caches" >&2
  else
  sudo sync
  echo 1 | sudo tee /proc/sys/vm/drop_caches >/dev/null
  fi
done
